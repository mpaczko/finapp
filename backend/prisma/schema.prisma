generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  category   String
  date       DateTime @db.Date
  cost       Decimal  @db.Decimal(12, 2)
  user_id    String   @db.Uuid

  @@index([user_id, date])
  @@map("expenses")
}

model Category {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  key        String
  user_id    String   @db.Uuid

  @@unique([user_id, key])
  @@index([user_id])
  @@map("categories")
}

model Budget {
  id                     Int      @id @default(autoincrement())
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  month                  String   @db.VarChar(7)
  previous_month_savings Decimal  @default(0) @db.Decimal(12, 2)
  income                 Decimal  @default(0) @db.Decimal(12, 2)
  rent                   Decimal  @default(0) @db.Decimal(12, 2)
  media                  Decimal  @default(0) @db.Decimal(12, 2)
  home_stuff             Decimal  @default(0) @db.Decimal(12, 2)
  food                   Decimal  @default(0) @db.Decimal(12, 2)
  hangouts               Decimal  @default(0) @db.Decimal(12, 2)
  parties                Decimal  @default(0) @db.Decimal(12, 2)
  suplements             Decimal  @default(0) @db.Decimal(12, 2)
  entertainment          Decimal  @default(0) @db.Decimal(12, 2)
  health_and_beauty      Decimal  @default(0) @db.Decimal(12, 2)
  travels                Decimal  @default(0) @db.Decimal(12, 2)
  transport              Decimal  @default(0) @db.Decimal(12, 2)
  clothes                Decimal  @default(0) @db.Decimal(12, 2)
  investments            Decimal  @default(0) @db.Decimal(12, 2)
  others                 Decimal  @default(0) @db.Decimal(12, 2)
  ip_box                 Decimal  @default(0) @db.Decimal(12, 2)
  user_id                String   @db.Uuid

  @@unique([user_id, month])
  @@index([user_id, month])
  @@map("budgets")
}
