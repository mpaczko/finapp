generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  category   String
  date       DateTime @db.Date
  cost       Decimal  @db.Decimal(12, 2)
  user_id    String   @db.Uuid

  @@index([user_id, date])
  @@map("expenses")
}

model Category {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  name       String
  key        String
  user_id    String   @db.Uuid

  @@unique([user_id, key])
  @@index([user_id])
  @@map("categories")
}

model Budget {
  id                     BigInt   @id @default(autoincrement())
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  month                  String?  @db.Text
  previous_month_savings Float?
  income                 Float?
  rent                   Float?
  media                  Float?
  home_stuff             Float?
  food                   Float?
  hangouts               Float?
  parties                Float?
  suplements             Float?
  entertainment          Float?
  health_and_beauty      Float?
  travels                Float?
  transport              Float?
  clothes                Float?
  investments            Float?
  others                 Float?
  ip_box                 Float?
  user_id                String?  @db.Uuid

  @@index([user_id, month])
  @@map("budgets")
}
